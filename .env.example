# Copy this file to .env.local for local work. On Vercel, add the same names under
# Project Settings > Environment Variables. Never commit real values.

# REQUIRED: DATABASE_URL, DIRECT_URL.
# OPTIONAL: NEXT_PUBLIC_SITE_URL, ADMIN_SECRET, EMAIL_ENABLED and the SMTP_* / MAIL_FROM / TEAM_EMAIL values.

# --- Neon database (Postgres) ---
# DATABASE_URL: the POOLED connection string from the Neon dashboard (host contains "-pooler").
# DIRECT_URL: the DIRECT (non-pooled) connection string. Prisma uses it for `prisma db push`.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Site ---
# Leave this empty until your own domain is connected: the site then uses the Vercel address.
# After connecting swaara.lk set it to https://www.swaara.lk (see "Connecting swaara.lk" in the README).
NEXT_PUBLIC_SITE_URL=""

# --- Email (OPTIONAL, off by default) ---
# The site does not send any email unless EMAIL_ENABLED is exactly "true". With it off, sign-ups and
# messages are still saved and the visitor still sees a success message. All the email code is kept,
# so to switch it on later set EMAIL_ENABLED="true" and fill in the SMTP_* values.
EMAIL_ENABLED="false"
# Works with the team Gmail account: turn on 2-Step Verification, then create an "App password" at
# https://myaccount.google.com/apppasswords and paste it as SMTP_PASS. MAIL_FROM must use the same Gmail address.
TEAM_EMAIL="teamswara.reads@gmail.com"
MAIL_FROM="SWAARA <teamswara.reads@gmail.com>"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="teamswara.reads@gmail.com"
SMTP_PASS=""

# --- Admin page (/admin) ---
# The admin password is set in src/lib/auth.ts, so no password variable is needed.
# ADMIN_SECRET is OPTIONAL: a long random string (at least 16 characters) that signs the login cookie.
# Without it a built-in value is used. Generate one with:  openssl rand -hex 32
ADMIN_SECRET=""
